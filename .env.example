# Copy to .env and fill in.  .env is gitignored: never commit real IDs.
# The client secret is NOT set here; it lives in ./secrets/oauth_client_secret
# (mode 0600, gitignored) and is mounted into the container as a Docker secret.

# Microsoft Entra: Directory (tenant) ID and the app registration's Application (client) ID.
OAUTH_TENANT_ID=00000000-0000-0000-0000-000000000000
OAUTH_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Mailbox the application is allowed to send as (granted FullAccess in Exchange
# Online).  Used as the XOAUTH2 user and should match the envelope sender.
SENDER_ADDRESS=relay@example.com

# Hostname Postfix announces in HELO/EHLO to Microsoft.
POSTFIX_MYHOSTNAME=smtp.example.com

# Host side of the published, unauthenticated SMTP port: "1025" (all
# interfaces) or "192.0.2.10:1025" (one address).
SMTP_LISTEN=1025

TZ=Australia/Sydney
